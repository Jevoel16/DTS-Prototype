# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=deped_dts
# Use a dedicated least-privilege account in production, never root, e.g.:
#   CREATE USER 'dts_app'@'localhost' IDENTIFIED BY '<strong password>';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON deped_dts.* TO 'dts_app'@'localhost';
# (migrations, seeders and backup restore need a separate admin account with DDL rights)
DB_USERNAME=root
DB_PASSWORD=

# Show PHP errors in the browser (development only)
APP_DEBUG=false

# local | production. production forces Secure session cookies and blocks the dev-only
# scripts (seeders, corrupt.php, concurrency_test.php)
APP_ENV=local

# Public base URL. Printed on tracking forms (falls back to the request host when empty)
# and called by the Node seeder (seed:dev); use http://localhost:8000 with the php -S fallback
# APP_URL=https://localhost:8000

# Secret that seals the document hash chain (HMAC). Generate once with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# then run `composer run seal`. Keep it out of the database and back it up separately:
# losing it means existing logs can no longer be verified.
APP_INTEGRITY_KEY=

# Encrypts backup zips (AES-256). Keep a copy off the server: backups can't be restored without it.
BACKUP_PASSWORD=

# How many of the newest backup zips to keep; older ones are deleted after each new backup.
# 0 keeps every backup (watch disk space). Copy important backups off the server.
BACKUP_KEEP=30

# Only needed when PHP sees a proxy's address directly (e.g. php -S behind cloudflared).
# Under the bundled nginx config, the real client IP is already restored for PHP.
# TRUSTED_PROXIES=127.0.0.1,::1

# Windows only: path to nginx.exe or its folder (default: C:\nginx, then PATH)
# NGINX_PATH=C:\nginx

# Windows only: path to openssl.exe or its folder (default: PATH, then Git for Windows' bundled copy)
# OPENSSL_PATH=C:\Program Files\Git\usr\bin
