# --- backup-laravel ---
/backup-laravel/auth.json
/backup-laravel/public/build/
/backup-laravel/public/hot/
/backup-laravel/public/storage/
/backup-laravel/storage/*.key
/backup-laravel/vendor/
/backup-laravel/lang/
/backup-laravel/dumps/
/backup-laravel/dist/
/backup-laravel/sources/
/backup-laravel/old/
/backup-laravel/commit.md
/backup-laravel/GEMINI.md
/backup-laravel/FINDINGS.md
/backup-laravel/database/database.sqlite
/backup-laravel/database/database.sqlite-journal
/backup-laravel/database/*.sqlite*

/backup-laravel/database/database_backups/*
